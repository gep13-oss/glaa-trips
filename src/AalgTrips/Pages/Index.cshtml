@page
@inject AlbumCollection ac
@{
    ViewData["Title"] = "Albums";
    ViewData["Description"] = $"An online gallery where I share my photos with the world. Currently showing {ac.Albums.Count} albums ({string.Join(", ", ac.Albums.Select(a => a.Id))})";
    ViewData["Image"] = Request.Scheme + "://" + Request.Host + ac.Albums.FirstOrDefault()?.CoverPhoto?.GetThumbnailLink((int)ImageType.Full, out int h);

    bool signedIn = User.Identity != null && User.Identity.IsAuthenticated;

    // Filter options: only offer a castle toggle / a person's chip when at least
    // one trip actually uses it, and list the people in canonical order (known
    // people first, then any extra names) so the bar stays tidy.
    bool anyCastle = ac.Albums.Any(a => a.CastleVisited);
    var usedPeople = ac.Albums.SelectMany(a => a.People).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
    var peopleInUse = KnownPeople.All.Where(p => usedPeople.Contains(p, StringComparer.OrdinalIgnoreCase))
        .Concat(usedPeople.Where(p => !KnownPeople.All.Contains(p, StringComparer.OrdinalIgnoreCase)))
        .ToList();
}

<div id="admin" class="page-actions" if-authorized>
    <button type="button" class="btn btn--primary" data-open-dialog="#addTripDialog">Add trip</button>

    <dialog id="addTripDialog" class="modal" aria-label="New trip">
        <form class="trip-form modal__form" method="post" action="~/album/new/create/">
            <h2 class="trip-form__title">New trip</h2>
            <button type="button" class="modal__close" data-close-dialog aria-label="Close">&times;</button>

            <div class="field field--place">
                <label for="name">Place</label>
                <input type="text" name="name" id="name" required placeholder="e.g. New Slains Castle" />
            </div>
            <div class="field field--date">
                <label for="visited">Date visited</label>
                <input type="date" name="visited" id="visited" />
            </div>
            <div class="field field--notes">
                <label for="description">Notes</label>
                <textarea name="description" id="description" rows="4" placeholder="A few lines about the trip…"></textarea>
            </div>
            <div class="field field--lat">
                <label for="latitude">Latitude</label>
                <input type="number" step="any" name="latitude" id="latitude" placeholder="57.4183" />
            </div>
            <div class="field field--long">
                <label for="longitude">Longitude</label>
                <input type="number" step="any" name="longitude" id="longitude" placeholder="-1.8618" />
            </div>
            <div class="field field--castle field--check">
                <label class="check-label" for="castleVisited">
                    <input type="checkbox" name="castleVisited" id="castleVisited" value="true" />
                    Castle visited
                </label>
            </div>
            <partial name="_PeopleChecklist" model="System.Array.Empty<string>()" />
            <div class="field field--actions">
                <button type="button" class="btn btn--ghost" data-close-dialog>Cancel</button>
                <input type="submit" id="newalbum" class="btn btn--primary" value="Add trip" data-progress="Creating…" />
            </div>
        </form>
    </dialog>
</div>

<section class="map-hero">
    <div id="map" data-markers-url="@ac.MarkersUrl()"></div>
</section>

@if (ac.Albums.Count == 0)
{
    <p class="empty">
        @if (signedIn)
        {
            <text>No trips yet — add your first with the “Add trip” button above.</text>
        }
        else
        {
            <text>No trips have been shared yet.</text>
        }
    </p>
}
else
{
    <section class="trips">
        <div class="section-head">
            <h2 class="section-head__title">Trips</h2>
            <span class="section-head__count">@ac.Albums.Count trip@(ac.Albums.Count == 1 ? "" : "s")</span>
        </div>

        @if (anyCastle || peopleInUse.Count > 0)
        {
            <div class="filters" id="filters" hidden>
                <span class="filters__label">Filter</span>
                @if (anyCastle)
                {
                    <label class="chip"><input type="checkbox" class="filter-castle" /><span>Castles</span></label>
                }
                @foreach (var person in peopleInUse)
                {
                    <label class="chip"><input type="checkbox" class="filter-person" value="@person" /><span>@person</span></label>
                }
                @if (peopleInUse.Count > 0)
                {
                    <label class="filters__exact" title="Show only trips with exactly the selected people"><input type="checkbox" class="filter-exact" /> Exact match</label>
                }
                <button type="button" class="filters__clear" hidden>Clear</button>
            </div>
        }

        <div class="trip-grid">
            @foreach (Album album in ac.Albums)
            {
                var cover = album.CoverPhoto;
                <a class="trip-card" href="/album/@album.UrlName/" data-castle="@(album.CastleVisited ? "true" : "false")" data-people="@string.Join("|", album.People)">
                    <div class="trip-card__media">
                        @if (album.CastleVisited)
                        {
                            <span class="trip-card__castle" title="Castle visited" aria-label="Castle visited">
                                <svg viewBox="0 0 24 24" fill="currentColor" fill-rule="evenodd" aria-hidden="true" focusable="false">
                                    <path d="M3 21V9h2V7h2v2h2V7h2v2h2V7h2v2h2V7h2v2h2v12H3Zm7 0v-6a2 2 0 0 1 4 0v6h-4Z" />
                                </svg>
                            </span>
                        }
                        @if (cover != null)
                        {
                            <img photo="@cover" type="Cover" />
                        }
                        else
                        {
                            <div class="trip-card__placeholder"></div>
                        }
                    </div>
                    <div class="trip-card__body">
                        <h3 class="trip-card__title">@album.DisplayName</h3>
                        <p class="trip-card__dossier">
                            <span class="coord">@album.Coordinates</span>
                            <span class="sep">·</span>
                            <span class="date">@album.Visited.ToString("d MMM yyyy").ToUpperInvariant()</span>
                            <span class="sep">·</span>
                            <span class="count">@album.Photos.Count photo@(album.Photos.Count == 1 ? "" : "s")</span>
                        </p>
                        @if (album.People.Count > 0)
                        {
                            <p class="trip-card__people"><span class="trip-card__people-label">Who</span> @string.Join(", ", album.People)</p>
                        }
                    </div>
                </a>
            }
        </div>

        <p class="trips-empty" id="tripsEmpty" hidden>No trips match your selections.</p>
    </section>
}

@section head {
    <link rel="stylesheet" href="/lib/leaflet/leaflet.css" />
    <link rel="stylesheet" href="/lib/leaflet.markercluster/MarkerCluster.css" />
    <link rel="stylesheet" href="/lib/leaflet.markercluster/MarkerCluster.Default.css" />
}

@section scripts {
    <script src="/lib/leaflet/leaflet.js"></script>
    <script src="/lib/leaflet.markercluster/leaflet.markercluster.js"></script>
    <script src="~/js/map.js" asp-append-version="true"></script>
    <script src="~/js/filters.js" asp-append-version="true"></script>
    <script if-authorized src="~/js/admin.js" async asp-append-version="true"></script>
}
