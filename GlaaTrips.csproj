<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>disable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <UserSecretsId>5966cb71-2501-4cab-a0aa-77b24d37f516</UserSecretsId>
        <!-- This web app lives at the repo root, so its default item globs
             would otherwise sweep up the Cake build script and the test
             project that sit alongside it. Exclude them. -->
        <DefaultItemExcludes>$(DefaultItemExcludes);cake.cs;tests/**</DefaultItemExcludes>
    </PropertyGroup>

    <ItemGroup>
        <!-- Retained for now; slated for review/removal in the dependency-reduction step. -->
        <PackageReference Include="Microsoft.ApplicationInsights.AspNetCore" Version="3.1.2" />
        <PackageReference Include="SkiaSharp" Version="2.88.9" />
        <PackageReference Include="WebEssentials.AspNetCore.CdnTagHelpers" Version="1.0.21" />
        <PackageReference Include="Slugify.Core" Version="3.0.0" />
    </ItemGroup>

    <!--
      Removed in the .NET 10 migration:
        * Microsoft.AspNetCore.All  - 2.1-only metapackage; the framework
          reference is now provided implicitly by Microsoft.NET.Sdk.Web.
        * System.Text.Json          - ships in the shared framework.
      MvcRazorCompileOnPublish / ApplicationInsightsResourceId dropped
      (defaults / not needed for build).
    -->
</Project>
