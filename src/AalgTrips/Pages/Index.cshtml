@page
@inject AlbumCollection ac
@{
    ViewData["Title"] = "Albums";
    ViewData["Description"] = $"An online gallery where I share my photos with the world. Currently showing {ac.Albums.Count} albums ({string.Join(", ", ac.Albums.Select(a => a.Id))})";
    ViewData["Image"] = Request.Scheme + "://" + Request.Host + ac.Albums.FirstOrDefault()?.CoverPhoto?.GetThumbnailLink((int)ImageType.Full, out int h);

    bool signedIn = User.Identity != null && User.Identity.IsAuthenticated;
}

<form id="admin" class="trip-form" if-authorized method="post" action="~/album/new/create/">
    <h2 class="trip-form__title">New trip</h2>

    <div class="field field--place">
        <label for="name">Place</label>
        <input type="text" name="name" id="name" required placeholder="e.g. New Slains Castle" />
    </div>
    <div class="field field--notes">
        <label for="description">Notes</label>
        <input type="text" name="description" id="description" placeholder="A line about the trip" />
    </div>
    <div class="field field--date">
        <label for="visited">Date visited</label>
        <input type="date" name="visited" id="visited" />
    </div>
    <div class="field field--lat">
        <label for="latitude">Latitude</label>
        <input type="number" step="any" name="latitude" id="latitude" placeholder="57.4183" />
    </div>
    <div class="field field--long">
        <label for="longitude">Longitude</label>
        <input type="number" step="any" name="longitude" id="longitude" placeholder="-1.8618" />
    </div>
    <div class="field field--actions">
        <input type="submit" id="newalbum" class="btn btn--primary" value="Add trip" data-progress="Creating…" />
    </div>
</form>

<section class="map-hero">
    <div id="map" data-markers-url="@ac.MarkersUrl()"></div>
</section>

@if (ac.Albums.Count == 0)
{
    <p class="empty">
        @if (signedIn)
        {
            <text>No trips yet — add your first with the form above.</text>
        }
        else
        {
            <text>No trips have been shared yet.</text>
        }
    </p>
}
else
{
    <section class="trips">
        <div class="section-head">
            <h2 class="section-head__title">Trips</h2>
            <span class="section-head__count">@ac.Albums.Count trip@(ac.Albums.Count == 1 ? "" : "s")</span>
        </div>

        <div class="trip-grid">
            @foreach (Album album in ac.Albums)
            {
                var cover = album.CoverPhoto;
                <a class="trip-card" href="/album/@album.UrlName/">
                    <div class="trip-card__media">
                        @if (cover != null)
                        {
                            <img photo="@cover" type="Cover" />
                        }
                        else
                        {
                            <div class="trip-card__placeholder"></div>
                        }
                    </div>
                    <div class="trip-card__body">
                        <h3 class="trip-card__title">@album.DisplayName</h3>
                        <p class="trip-card__dossier">
                            <span class="coord">@album.Coordinates</span>
                            <span class="sep">·</span>
                            <span class="date">@album.Visited.ToString("MMM yyyy").ToUpperInvariant()</span>
                            <span class="sep">·</span>
                            <span class="count">@album.Photos.Count photo@(album.Photos.Count == 1 ? "" : "s")</span>
                        </p>
                    </div>
                </a>
            }
        </div>
    </section>
}

@section head {
    <link rel="stylesheet" href="/lib/leaflet/leaflet.css" />
    <link rel="stylesheet" href="/lib/leaflet.markercluster/MarkerCluster.css" />
    <link rel="stylesheet" href="/lib/leaflet.markercluster/MarkerCluster.Default.css" />
}

@section scripts {
    <script src="/lib/leaflet/leaflet.js"></script>
    <script src="/lib/leaflet.markercluster/leaflet.markercluster.js"></script>
    <script src="~/js/map.js" asp-append-version="true"></script>
    <script if-authorized src="~/js/admin.js" async asp-append-version="true"></script>
}
