{
  "forcessl": false,
  // Admin credentials. Do NOT commit real values here. Set them per
  // environment via user-secrets (development) or environment variables
  // (production), for example:
  //   dotnet user-secrets set "user:username" "<name>"
  //   dotnet user-secrets set "user:salt"     "<salt>"
  //   dotnet user-secrets set "user:password" "<PBKDF2 hash>"
  "user": {
    "username": "",
    "password": "",
    "salt": ""
  },
  // Where album content (photos, thumbnails, metadata, markers) is stored.
  // "LocalDisk" (default) serves from wwwroot/albums and is used for
  // development and tests. "AzureBlob" stores content in an Azure Blob
  // container so it survives redeploys and can be served from a CDN. Do NOT
  // commit a real connection string here; set it per environment via
  // user-secrets or environment variables, for example:
  //   dotnet user-secrets set "Storage:AzureBlob:ConnectionString" "<conn>"
  // PublicBaseUrl is the CDN (or container) base URL content is served from;
  // leave empty to serve directly from the container URL.
  "Storage": {
    "Provider": "LocalDisk",
    "AzureBlob": {
      "ConnectionString": "",
      "ContainerName": "albums",
      "PublicBaseUrl": ""
    }
  },
  "Logging": {
    "IncludeScopes": false,
    "Debug": {
      "LogLevel": {
        "Default": "Warning"
      }
    },
    "Console": {
      "LogLevel": {
        "Default": "Warning"
      }
    }
  }
}
