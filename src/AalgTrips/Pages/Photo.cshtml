@page "{albumName}/{photoName}/{handler?}"
@model PhotoModel
@{
    ViewData["Title"] = $"{Model.Photo.DisplayName} - {Model.Photo.Album.Id}";
    ViewData["Description"] = $"{Model.Photo.DisplayName} from the album {Model.Photo.Album.Id}";
    ViewData["Image"] = Request.Scheme + "://" + Request.Host + Model.Photo.GetThumbnailLink((int)ImageType.Full, out int h);
}

<div id="admin" class="admin-panel" if-authorized>
    <form class="upload-row" method="post">
        <div class="field">
            <label for="photoname">Caption</label>
            <input type="text" name="name" id="photoname" aria-label="Name" required value="@Model.Photo.DisplayName" />
        </div>
        <input type="submit" class="btn btn--primary" asp-page-handler="rename" data-progress="Renaming…" value="Rename" />
    </form>

    <form method="post" class="delete">
        <input type="submit" class="admin-delete" id="deletephoto" asp-page-handler="delete" aria-label="Delete photo" title="Delete photo" value="Delete photo" />
    </form>
</div>

<header class="album-head">
    <div class="album-head__top">
        <h1 class="album-head__title">@Model.Photo.DisplayName</h1>
        <paging model="@Model.Photo" />
    </div>
    <p class="album-head__dossier">
        <span>In</span> <a href="@Model.Photo.Album.Link">@Model.Photo.Album.Id</a>
    </p>
</header>

<div class="photo">
    <div class="pic">
        <img photo="@Model.Photo" type="Full" />
    </div>
    <aside>
        <a href="@Model.Photo.DownloadLink" class="download">Download original</a>
    </aside>
</div>

@section scripts {
    <script if-authorized src="~/js/admin.js" async asp-append-version="true"></script>
}

@section head {
    <link rel="index" href="@Model.Photo.Album.Link" />
    @if (Model.Photo.Next != null)
    {
        <link rel="next" href="@Model.Photo.Next.Link" />
        <link rel="prefetch" href="@Model.Photo.Next.Link" />
    }

    @if (Model.Photo.Previous != null)
    {
        <link rel="prev" href="@Model.Photo.Previous.Link" />
    }
}
